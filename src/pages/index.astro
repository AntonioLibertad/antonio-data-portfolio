    imageAlt:
      "Preview of the Excel FP&A workbook layer for the Driver-Based FP&A Planning & Forecasting project",
    eyebrow: "FP&A / Controlling / Planning & Forecasting",
    badge: "FP&A case",
    title: "Driver-Based FP&A Planning & Forecasting",
    description:
      "Driver-based FP&A planning and Power BI reporting case showing how stable demand can still translate into weaker profitability when discounting, returns, and cost-to-serve pressure build below revenue.",
    highlights: [
      "Budget / Actual / LF",
      "Excel FP&A pack",
      "P&L variance story",
    ],
