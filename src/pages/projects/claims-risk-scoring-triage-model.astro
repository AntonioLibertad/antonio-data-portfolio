    font-size: 20px;
    line-height: 1.45;
  }

  .split-section {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }

  .story-card {
    border-radius: 28px;
    padding: 30px;
  }

  .story-card.accent {
    border-color: rgba(52, 211, 153, 0.35);
  }

  .story-card ul {
    margin: 18px 0 0;
