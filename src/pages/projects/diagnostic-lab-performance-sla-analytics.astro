---
const pageTitle = "Diagnostic Lab Performance & SLA Analytics | Antonio González Martín";
const pageDescription =
  "Operational analytics case for a diagnostic laboratory network, focused on SLA reliability, workflow bottlenecks, rework impact and site-level quality actions.";

const project = {
  title: "Diagnostic Lab Performance & SLA Analytics",
  subtitle:
    "A healthcare operations case where a diagnostic lab receives enough volume, but lacks visibility into where SLA breaches, delays, rework and bottlenecks are actually happening.",
  eyebrow: "Healthcare Analytics / SLA / Operational BI",
  heroImage: "/images/projects/diagnostic-lab/diagnostic-lab-overview.png",
  tags: [
    "Power BI",
    "SQL",
    "Python",
    "Pandas",
    "SQLite",
    "Power Query",
    "DAX",
    "Operational Analytics",
    "Healthcare Analytics",
    "SLA Reporting",
    "Data Quality",
  ],
};

const galleryItems = [
  {
    title: "Executive Operations Overview",
    src: "/images/projects/diagnostic-lab/diagnostic-lab-overview.png",
    alt: "Executive overview page of the diagnostic lab analytics dashboard",
    caption:
      "The front-door view for management: overall SLA stability, workload mix, test-group performance and the first executive readout.",
    insight:
      "The lab is stable overall, but complex workflows reveal recurring SLA pressure.",
  },
  {
    title: "Workflow & SLA Risk Concentration",
    src: "/images/projects/diagnostic-lab/diagnostic-lab-workflow-risk.png",
    alt: "Workflow and SLA risk concentration page of the diagnostic lab analytics dashboard",
    caption:
      "A workflow-level risk map separating volume exposure, breach rate and P90 turnaround risk.",
    insight:
      "Routine Blood creates many breaches because it carries the largest workload, but the more actionable risk sits in Microbiology, Pathology and Molecular Diagnostics.",
  },
  {
    title: "Bottleneck & Stage Flow Analysis",
    src: "/images/projects/diagnostic-lab/diagnostic-lab-stage-flow.png",
    alt: "Bottleneck and stage flow analysis page of the diagnostic lab analytics dashboard",
    caption:
      "A stage-level view showing where turnaround time is consumed and where avoidable waiting appears inside the sample journey.",
    insight:
      "Testing explains process duration, but validation explains avoidable waiting.",
  },
  {
    title: "Rework & Site Quality Action View",
    src: "/images/projects/diagnostic-lab/diagnostic-lab-action-view.png",
    alt: "Rework and site quality action view of the diagnostic lab analytics dashboard",
    caption:
      "An action-oriented page connecting rework impact with source-site quality patterns and management recommendations.",
    insight:
      "Rework is a small-volume issue with disproportionate SLA impact, and quality action should be targeted by source site.",
  },
  {
    title: "Data Quality & Clean Reporting Layer",
    src: "/images/projects/diagnostic-lab/diagnostic-lab-data-quality.png",
    alt: "Data quality and validation screenshot from the diagnostic lab analytics project",
    caption:
      "Raw operational data was checked for duplicate samples, timestamp issues, SLA target logic, status conflicts and stage-event validity before reporting.",
    insight:
      "The dashboard is built on a validated clean layer, not directly on raw operational extracts.",
  },
];

const keyMetrics = [
  {
    value: "40,000",
    label: "clean sample records",
  },
  {
    value: "200,000",
    label: "stage-event records",
  },
  {
    value: "39,601",
    label: "valid released samples",
  },
  {
    value: "87.5%",
    label: "overall SLA compliance",
  },
];

const findings = [
  {
    title: "The lab is not failing overall.",
    text:
      "SLA compliance is stable at 87.5%, and routine / urgent workflows are mostly protected.",
  },
  {
    title: "SLA risk is concentrated.",
    text:
      "Pathology, Molecular Diagnostics and Microbiology repeatedly sit below the lab average.",
  },
  {
    title: "Validation is the actionable bottleneck.",
    text:
      "Testing naturally takes time, but validation queue is where avoidable waiting becomes visible.",
  },
  {
    title: "Rework has disproportionate impact.",
    text:
      "Reworked samples represent 8.3% of volume but account for 28.9% of SLA breaches.",
  },
];

const workflowSteps = [
  {
    label: "01",
    title: "Raw operational data",
    text:
      "Sample-level and stage-level data covering diagnostic workflows, priorities, sites, timestamps, SLA targets, rework and quality flags.",
  },
  {
    label: "02",
    title: "Data quality checks",
    text:
      "Duplicates, missing timestamps, invalid stage durations, SLA target gaps and status conflicts were identified before creating reporting tables.",
  },
  {
    label: "03",
    title: "Clean analytical model",
    text:
      "Created fact and dimension tables for samples, stage events, dates, sites, departments, priorities and test groups.",
  },
  {
    label: "04",
    title: "SQL KPI validation",
    text:
      "Core KPIs were reproduced through SQL before dashboarding: SLA compliance, breach volume, P90 turnaround, queue time and rework impact.",
  },
  {
    label: "05",
    title: "Power BI executive reporting",
    text:
      "Built a four-page dashboard focused on management visibility, bottleneck diagnosis and targeted action prioritization.",
  },
];

const dashboardPages = [
  {
    page: "Page 1",
    title: "Executive Operations Overview",
    question:
      "Is the lab meeting service expectations overall, and where is reliability risk visible at a high level?",
    read:
      "The lab is stable overall, but complex workflows reveal recurring SLA pressure.",
  },
  {
    page: "Page 2",
    title: "Workflow & SLA Risk Concentration",
    question:
      "Which workflows deserve management attention because they combine breach volume, weak SLA performance and long turnaround tails?",
    read:
      "Routine Blood has volume exposure, while complex workflows carry more actionable risk exposure.",
  },
  {
    page: "Page 3",
    title: "Bottleneck & Stage Flow Analysis",
    question:
      "Where inside the sample journey is turnaround time being lost, and which part is actually actionable?",
    read:
      "Testing consumes process time, but validation creates the clearest avoidable waiting signal.",
  },
  {
    page: "Page 4",
    title: "Rework & Site Quality Action View",
    question:
      "Which quality issues should management act on first, and where should those actions be targeted?",
    read:
      "Rework is small in volume but large in SLA impact, and site-level patterns help target action.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="brand">Antonio González Martín</a>

        <nav class="nav-links">
          <a href="/#projects">Projects</a>
          <a href="/#about">About</a>
          <a href="/#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="project-hero">
        <div class="container">
          <a href="/#projects" class="back-link">← Back to selected work</a>

          <div class="hero-layout">
            <div class="hero-copy reveal reveal-left">
              <p class="project-eyebrow">{project.eyebrow}</p>

              <h1>{project.title}</h1>

              <p class="hero-subtitle">{project.subtitle}</p>

              <div class="hero-metrics" aria-label="Project key metrics">
                <div>
                  <strong>39,601</strong>
                  <span>valid released samples</span>
                </div>
                <div>
                  <strong>87.5%</strong>
                  <span>SLA compliance</span>
                </div>
                <div>
                  <strong>28.9%</strong>
                  <span>breaches from rework</span>
                </div>
              </div>

              <div class="hero-tags">
                {project.tags.slice(0, 6).map((tag) => <span>{tag}</span>)}
              </div>

              <div class="hero-actions">
                <a href="#dashboard" class="button button-primary">View dashboard story</a>
                <a href="#technical-foundation" class="button button-secondary">See technical foundation</a>
              </div>
            </div>

            <figure class="hero-showcase reveal reveal-right">
              <div class="hero-showcase-glow"></div>
              <div class="hero-showcase-frame">
                <img src={project.heroImage} alt="Diagnostic Lab Performance & SLA Analytics dashboard overview" />
              </div>
            </figure>
          </div>
        </div>
      </section>

      <section class="section problem-section">
        <div class="container">
          <div class="problem-card reveal reveal-up">
            <p class="section-label">Business problem</p>
            <h2>The lab has enough volume. What it lacks is operational visibility.</h2>

            <p class="lead">
              A diagnostic laboratory network receives stable sample volume, but management does not
              have a clear view of where delays, rework, backlog pressure and SLA breaches are happening.
            </p>

            <p>
              Overall SLA compliance looks relatively stable, but that average hides recurring pressure
              in complex diagnostic workflows, validation queues and reworked samples. The challenge is
              not simply to report KPIs. The real question is where management should act first.
            </p>
          </div>

          <div class="metrics-grid">
            {keyMetrics.map((metric, index) => (
              <article class="metric-card reveal reveal-up" style={`--reveal-delay: ${80 + index * 70}ms;`}>
                <strong>{metric.value}</strong>
                <span>{metric.label}</span>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="dashboard" class="section dashboard-section">
        <div class="container">
          <div class="section-heading reveal reveal-up">
            <p class="section-label">Dashboard story</p>
            <h2>Four pages, four different management questions.</h2>
            <p>
              Each page earns its place by answering a different operational question. The dashboard
              moves from executive visibility to workflow risk, bottleneck diagnosis and targeted action.
            </p>
          </div>

          <div class="dashboard-gallery reveal reveal-scale">
            <div class="gallery-main">
              <button type="button" class="gallery-arrow gallery-arrow-left" id="gallery-prev" aria-label="Previous screenshot">
                ←
              </button>

              <figure class="gallery-image-wrap">
                <img
                  id="gallery-image"
                  src={galleryItems[0].src}
                  alt={galleryItems[0].alt}
                />
              </figure>

              <button type="button" class="gallery-arrow gallery-arrow-right" id="gallery-next" aria-label="Next screenshot">
                →
              </button>
            </div>

            <div class="gallery-content">
              <div>
                <p class="gallery-kicker">Dashboard page</p>
                <h3 id="gallery-title">{galleryItems[0].title}</h3>
                <p id="gallery-caption">{galleryItems[0].caption}</p>
                <div class="insight-box">
                  <span>Key read</span>
                  <strong id="gallery-insight">{galleryItems[0].insight}</strong>
                </div>
              </div>

              <div class="gallery-thumbs">
                {galleryItems.map((item, index) => (
                  <button
                    type="button"
                    class={`gallery-thumb ${index === 0 ? "is-active" : ""}`}
                    data-gallery-index={index}
                    aria-pressed={index === 0 ? "true" : "false"}
                  >
                    {index + 1}
                  </button>
                ))}
              </div>
            </div>
          </div>

          <div class="dashboard-page-grid">
            {dashboardPages.map((page, index) => (
              <article class="dashboard-page-card reveal reveal-up" style={`--reveal-delay: ${70 + index * 80}ms;`}>
                <span>{page.page}</span>
                <h3>{page.title}</h3>
                <p class="dashboard-question">{page.question}</p>
                <p>{page.read}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="technical-foundation" class="section technical-section">
        <div class="container">
          <div class="technical-grid">
            <div class="technical-copy reveal reveal-left">
              <p class="section-label">Technical foundation</p>
              <h2>Built on validated sample-level and stage-level operational data.</h2>

              <p>
                The reporting model is based on two core fact tables:
                <strong>fact_samples</strong>, with one row per diagnostic sample, and
                <strong>fact_stage_events</strong>, with one row per sample-stage event.
              </p>

              <p>
                Supporting dimensions include test group, priority, department, site and date. The clean
                layer preserves 40,000 diagnostic samples and 200,000 stage events, with 39,601 samples
                valid for released-sample SLA reporting.
              </p>

              <div class="tech-stack">
                {project.tags.map((tag) => <span>{tag}</span>)}
              </div>
            </div>

            <div class="workflow-card reveal reveal-right">
              {workflowSteps.map((step) => (
                <article class="workflow-step">
                  <span>{step.label}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.text}</p>
                  </div>
                </article>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="section findings-section">
        <div class="container">
          <div class="section-heading reveal reveal-up">
            <p class="section-label">Key findings</p>
            <h2>The analysis separates stable operations from targeted reliability risk.</h2>
          </div>

          <div class="findings-grid">
            {findings.map((finding, index) => (
              <article class="finding-card reveal reveal-up" style={`--reveal-delay: ${70 + index * 80}ms;`}>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <h3>{finding.title}</h3>
                <p>{finding.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section value-section">
        <div class="container">
          <div class="value-shell reveal reveal-up">
            <div>
              <p class="section-label">What this project demonstrates</p>
              <h2>Data Analyst work with business judgement.</h2>
            </div>

            <div class="value-list">
              <div>
                <h3>KPI logic</h3>
                <p>Defined and validated SLA compliance, breach volume, turnaround, P90 tail risk, rework impact and queue-time metrics.</p>
              </div>
              <div>
                <h3>Operational diagnosis</h3>
                <p>Separated volume exposure from performance risk, and separated process duration from avoidable waiting.</p>
              </div>
              <div>
                <h3>Management reporting</h3>
                <p>Designed Power BI pages around decisions: what is happening, where risk sits, where time is lost and what action to prioritize.</p>
              </div>
            </div>
          </div>

          <div class="closing-card reveal reveal-up">
            <p class="section-label">Portfolio positioning</p>
            <h2>Why this case matters for Swiss Data Analyst roles</h2>
            <p>
              This project adds a healthcare / MedTech-adjacent operational analytics case to my portfolio.
              It shows practical work with KPI reporting, data quality checks, SQL validation, Power BI
              storytelling and process visibility in a regulated, service-heavy environment.
            </p>

            <div class="closing-actions">
              <a href="/#projects" class="button button-primary">Back to all projects</a>
              <a href="mailto:antonio.business444@gmail.com" class="button button-secondary">Contact me</a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <script is:inline>
      const galleryItems = [
        {
          title: "Executive Operations Overview",
          src: "/images/projects/diagnostic-lab/diagnostic-lab-overview.png",
          alt: "Executive overview page of the diagnostic lab analytics dashboard",
          caption:
            "The front-door view for management: overall SLA stability, workload mix, test-group performance and the first executive readout.",
          insight:
            "The lab is stable overall, but complex workflows reveal recurring SLA pressure.",
        },
        {
          title: "Workflow & SLA Risk Concentration",
          src: "/images/projects/diagnostic-lab/diagnostic-lab-workflow-risk.png",
          alt: "Workflow and SLA risk concentration page of the diagnostic lab analytics dashboard",
          caption:
            "A workflow-level risk map separating volume exposure, breach rate and P90 turnaround risk.",
          insight:
            "Routine Blood creates many breaches because it carries the largest workload, but the more actionable risk sits in Microbiology, Pathology and Molecular Diagnostics.",
        },
        {
          title: "Bottleneck & Stage Flow Analysis",
          src: "/images/projects/diagnostic-lab/diagnostic-lab-stage-flow.png",
          alt: "Bottleneck and stage flow analysis page of the diagnostic lab analytics dashboard",
          caption:
            "A stage-level view showing where turnaround time is consumed and where avoidable waiting appears inside the sample journey.",
          insight:
            "Testing explains process duration, but validation explains avoidable waiting.",
        },
        {
          title: "Rework & Site Quality Action View",
          src: "/images/projects/diagnostic-lab/diagnostic-lab-action-view.png",
          alt: "Rework and site quality action view of the diagnostic lab analytics dashboard",
          caption:
            "An action-oriented page connecting rework impact with source-site quality patterns and management recommendations.",
          insight:
            "Rework is a small-volume issue with disproportionate SLA impact, and quality action should be targeted by source site.",
        },
        {
          title: "Data Quality & Clean Reporting Layer",
          src: "/images/projects/diagnostic-lab/diagnostic-lab-data-quality.png",
          alt: "Data quality and validation screenshot from the diagnostic lab analytics project",
          caption:
            "Raw operational data was checked for duplicate samples, timestamp issues, SLA target logic, status conflicts and stage-event validity before reporting.",
          insight:
            "The dashboard is built on a validated clean layer, not directly on raw operational extracts.",
        },
      ];

      let currentGalleryIndex = 0;

      const galleryImage = document.getElementById("gallery-image");
      const galleryTitle = document.getElementById("gallery-title");
      const galleryCaption = document.getElementById("gallery-caption");
      const galleryInsight = document.getElementById("gallery-insight");
      const galleryPrev = document.getElementById("gallery-prev");
      const galleryNext = document.getElementById("gallery-next");
      const galleryThumbs = Array.from(document.querySelectorAll(".gallery-thumb"));

      function renderGallery(index) {
        currentGalleryIndex = index;
        const item = galleryItems[index];

        if (galleryImage) {
          galleryImage.src = item.src;
          galleryImage.alt = item.alt;
        }

        if (galleryTitle) galleryTitle.textContent = item.title;
        if (galleryCaption) galleryCaption.textContent = item.caption;
        if (galleryInsight) galleryInsight.textContent = item.insight;

        galleryThumbs.forEach((thumb, thumbIndex) => {
          const isActive = thumbIndex === index;
          thumb.classList.toggle("is-active", isActive);
          thumb.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      }

      galleryPrev?.addEventListener("click", () => {
        const nextIndex = (currentGalleryIndex - 1 + galleryItems.length) % galleryItems.length;
        renderGallery(nextIndex);
      });

      galleryNext?.addEventListener("click", () => {
        const nextIndex = (currentGalleryIndex + 1) % galleryItems.length;
        renderGallery(nextIndex);
      });

      galleryThumbs.forEach((thumb, index) => {
        thumb.addEventListener("click", () => renderGallery(index));
      });

      const revealItems = Array.from(document.querySelectorAll(".reveal"));
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      if (prefersReducedMotion.matches) {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.14,
            rootMargin: "0px 0px -10% 0px",
          }
        );

        revealItems.forEach((item) => revealObserver.observe(item));
      }
    </script>
  </body>
</html>

<style>
  :root {
    --bg: #07101f;
    --panel: rgba(18, 29, 50, 0.84);
    --panel-strong: rgba(20, 31, 54, 0.9);
    --text: #edf2ff;
    --muted: #b5c1dc;
    --line: rgba(255, 255, 255, 0.12);
    --accent: #91a9ff;
    --accent-soft: #d8e0ff;
    --green: #10b981;
    --green-soft: rgba(16, 185, 129, 0.14);
    --shadow: 0 22px 60px rgba(0, 0, 0, 0.26);
    --max: 1320px;
    --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--text);
    background:
      radial-gradient(circle at 18% 12%, rgba(145, 169, 255, 0.12), transparent 26%),
      radial-gradient(circle at 82% 22%, rgba(16, 185, 129, 0.11), transparent 30%),
      linear-gradient(180deg, #06101d 0%, #08111f 55%, #08111f 100%);
    line-height: 1.65;
    overflow-x: hidden;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    display: block;
    max-width: 100%;
  }

  strong {
    color: #f7f9ff;
  }

  .container {
    width: min(var(--max), calc(100% - 2rem));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    backdrop-filter: blur(16px);
    background: rgba(6, 16, 29, 0.74);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    min-height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .brand {
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 1.4rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .nav-links a:hover {
    color: var(--text);
  }

  .project-hero {
    padding: 2.25rem 0 4rem;
    min-height: calc(100vh - 76px);
    display: flex;
    align-items: center;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 1.25rem;
    color: var(--accent-soft);
    font-weight: 700;
    font-size: 0.94rem;
  }

  .hero-layout {
    display: grid;
    grid-template-columns: minmax(420px, 0.44fr) minmax(620px, 0.56fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .project-eyebrow,
  .section-label,
  .gallery-kicker {
    margin: 0 0 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.74rem;
    font-weight: 800;
    color: var(--accent-soft);
  }

  h1,
  h2,
  h3 {
    margin: 0;
    line-height: 1.08;
    letter-spacing: -0.04em;
  }

  h1 {
    max-width: 13.5ch;
    font-size: clamp(3.1rem, 4.6vw, 5.7rem);
    line-height: 0.96;
    letter-spacing: -0.068em;
    text-wrap: balance;
  }

  h2 {
    font-size: clamp(2rem, 3.4vw, 3rem);
    margin-bottom: 1rem;
    text-wrap: balance;
  }

  h3 {
    font-size: 1.18rem;
  }

  p {
    margin: 0 0 1rem;
    color: var(--muted);
  }

  .hero-subtitle {
    max-width: 680px;
    margin-top: 1.15rem;
    font-size: 1.08rem;
    line-height: 1.68;
    color: #d8e2f7;
  }

  .lead {
    font-size: 1.08rem;
    color: #d8e2f7;
  }

  .hero-metrics {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.72rem;
    margin-top: 1.35rem;
    max-width: 560px;
  }

  .hero-metrics div {
    border-radius: 18px;
    padding: 0.82rem 0.88rem;
    border: 1px solid rgba(255, 255, 255, 0.11);
    background: rgba(255, 255, 255, 0.045);
    backdrop-filter: blur(10px);
  }

  .hero-metrics strong {
    display: block;
    margin-bottom: 0.22rem;
    font-size: 1.22rem;
    line-height: 1;
    color: #f8fbff;
    letter-spacing: -0.035em;
  }

  .hero-metrics span {
    display: block;
    color: #b5c1dc;
    font-size: 0.76rem;
    line-height: 1.25;
  }

  .hero-tags,
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.62rem;
    margin-top: 1.2rem;
  }

  .hero-tags span,
  .tech-stack span {
    padding: 0.46rem 0.78rem;
    border-radius: 999px;
    border: 1px solid rgba(145, 169, 255, 0.18);
    background: rgba(145, 169, 255, 0.08);
    color: #edf2ff;
    font-size: 0.84rem;
    font-weight: 700;
  }

  .hero-actions,
  .closing-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  .button {
    min-height: 48px;
