    priorityByTrack: {
  "data-analyst-bi": 6,
  "business-analyst": 4,
  "fpa-controlling": 4,
},
    cta: "Open manufacturing controlling case study",
  },
  {
    href: "/projects/finance-data-foundation",
    image: "/FP_overview.png",
    imageAlt: "Preview of the Finance Data Foundation for FP&A and Controlling project",
