---
const project = {
  title: "Claims Risk Scoring & Triage Model",
  eyebrow: "Applied ML / Insurance Analytics / Human-in-the-Loop AI",
  subtitle:
    "A claims triage model that moves from a useful-but-not-ready baseline to an enriched, explainable, controlled-pilot-ready review workflow.",
  description:
    "Built a claims risk scoring workflow that first identifies when an intake-only model is not ready for deployment, then improves it through enriched operational signals, threshold optimization, explainability, watchlist design and controlled pilot governance.",
  heroImage:
    "/images/projects/claims-risk-scoring-triage/01_model_readiness_journey.png",
};

const gallery = [
  {
    src: "/images/projects/claims-risk-scoring-triage/03_enriched_feature_architecture.png",
    title: "Enriched feature architecture",
    description:
      "LLM-style text signals, document quality, provider history and early lifecycle indicators improve risk separation.",
  },
  {
    src: "/images/projects/claims-risk-scoring-triage/02_final_triage_policy.png",
    title: "Final triage operating model",
    description:
      "Priority review, watchlist/light review and standard processing are separated into clear operational layers.",
  },
  {
    src: "/images/projects/claims-risk-scoring-triage/04_case_level_explainability.png",
    title: "Case-level explainability",
    description:
      "Reviewer-friendly explanations translate model scores into understandable business drivers.",
  },
];

const finalMetrics = [
  { label: "ROC-AUC", value: "0.907", tone: "blue" },
  { label: "Precision", value: "75.1%", tone: "green" },
  { label: "Recall", value: "78.1%", tone: "green" },
  { label: "Review queue", value: "28.9%", tone: "cyan" },
];

const beforeAfter = [
  {
    stage: "Intake-only model",
    precision: "50.2%",
    recall: "72.0%",
    queue: "39.8%",
    decision: "Not ready",
    tone: "red",
  },
  {
    stage: "Enriched optimized model",
    precision: "75.1%",
    recall: "78.1%",
    queue: "28.9%",
    decision: "Controlled pilot ready",
    tone: "green",
  },
];

const phases = [
  {
    phase: "Phase 1",
    title: "Intake-only model",
    status: "Not deployment-ready",
    statusTone: "red",
    text: "The first model used only claim intake data. It had useful signal, but the review queue was too broad and not clean enough to justify operational deployment.",
    metrics: [
      { label: "Precision", value: "50.2%" },
      { label: "Recall", value: "72.0%" },
      { label: "Queue", value: "39.8%" },
    ],
  },
  {
    phase: "Phase 2",
    title: "Enriched optimized model",
    status: "Controlled pilot ready",
    statusTone: "green",
    text: "The second iteration enriched the feature layer with LLM-style text risk signals, document quality, provider history and early lifecycle indicators.",
    metrics: [
      { label: "Precision", value: "75.1%" },
      { label: "Recall", value: "78.1%" },
      { label: "Queue", value: "28.9%" },
    ],
  },
];

const stack = [
  "Python",
  "Pandas",
  "Scikit-learn",
  "Gradient Boosting",
  "Feature Engineering",
  "Threshold Analysis",
  "LLM-style Text Signals",
  "Model Monitoring",
  "Human-in-the-Loop AI",
];

const proofPoints = [
  "Built an end-to-end ML triage workflow, not an isolated notebook.",
  "Controlled for leakage by separating intake data from downstream claim outcomes.",
  "Translated model scores into an operational review policy with capacity constraints.",
  "Improved model readiness through richer business signals rather than model complexity alone.",
  "Added case-level explanations so reviewers can inspect and challenge recommendations.",
  "Defined monitoring, pause criteria and governance boundaries before pilot rollout.",
];

const files = [
  "reports/final_model_readiness_report.md",
  "reports/gradient_boosting_optimization_report.md",
  "reports/case_level_explainability_report.md",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.title} | Antonio Libertad</title>
    <meta
      name="description"
      content="Applied ML claims risk scoring project with enriched feature engineering, explainability, monitoring and controlled pilot governance."
    />
  </head>

  <body>
    <main class="project-page">
      <section class="hero-section">
        <div class="hero-inner">
          <a class="back-link" href="/">← Back to portfolio</a>

          <div class="hero-grid">
            <div class="hero-copy reveal-static">
              <p class="eyebrow">{project.eyebrow}</p>
              <h1>{project.title}</h1>
              <p class="hero-subtitle">{project.subtitle}</p>

              <div class="hero-tags">
                <span>Data Science / AI</span>
                <span>Risk Analytics</span>
                <span>Human-in-the-loop</span>
              </div>

              <p class="hero-description">{project.description}</p>

              <div class="hero-problem">
                <span>Business tension</span>
                <p>
                  The business was not blocked by model accuracy alone. It was blocked by whether the review queue would be useful, manageable and safe enough for human reviewers.
                </p>
              </div>

              <div class="hero-actions">
                <a href="#readiness" class="primary-button">View model journey</a>
                <a href="#gallery" class="secondary-button">View visuals</a>
              </div>
            </div>

            <button
              class="hero-image-card reveal-static"
              type="button"
              data-full-image={project.heroImage}
              data-image-title="Model readiness journey"
              aria-label="Open model readiness journey image"
            >
              <img src={project.heroImage} alt="Model readiness journey visual" />
            </button>
          </div>
        </div>
      </section>

      <section class="section metrics-section">
        <div class="section-heading">
          <p class="section-kicker">Final operating point</p>
          <h2>Controlled pilot ready, not automated decision-making.</h2>
          <p>
            The optimized Gradient Boosting model meets the target operating criteria for a controlled
            human-in-the-loop rollout. The model prioritizes review; it does not approve, reject or settle claims.
          </p>
        </div>

        <div class="metric-grid">
          {finalMetrics.map((metric) => (
            <article class={`metric-card ${metric.tone}`}>
              <span>{metric.label}</span>
              <strong>{metric.value}</strong>
            </article>
          ))}
        </div>
      </section>

      <section class="section compact-section">
        <div class="section-heading wide">
          <p class="section-kicker">Before vs after enrichment</p>
          <h2>The project became valuable when the first model was treated as a readiness signal, not a success story.</h2>
          <p>
            The first model could capture risk, but only by creating a broad and inefficient review queue.
            The enriched version improved both risk capture and operational efficiency.
          </p>
        </div>

        <div class="comparison-table">
          <div class="comparison-row comparison-header">
            <span>Stage</span>
            <span>Precision</span>
            <span>Recall</span>
            <span>Queue</span>
            <span>Decision</span>
          </div>

          {beforeAfter.map((row) => (
            <div class={`comparison-row ${row.tone}`}>
              <strong>{row.stage}</strong>
              <span>{row.precision}</span>
              <span>{row.recall}</span>
              <span>{row.queue}</span>
              <em>{row.decision}</em>
            </div>
          ))}
        </div>
      </section>

      <section id="readiness" class="section">
        <div class="section-heading wide">
          <p class="section-kicker">Model readiness journey</p>
          <h2>The important part is not just the final model. It is the decision process.</h2>
          <p>
            The first model was not forced into production. The project treats that result as a readiness
            decision, then simulates the next realistic step: shadow-mode learning and better data signal.
          </p>
        </div>

        <div class="phase-grid">
          {phases.map((phase) => (
            <article class={`phase-card ${phase.statusTone}`}>
              <div class="phase-topline">
                <span>{phase.phase}</span>
                <strong>{phase.status}</strong>
              </div>
              <h3>{phase.title}</h3>
              <p>{phase.text}</p>

              <div class="phase-metrics">
                {phase.metrics.map((metric) => (
                  <div>
                    <span>{metric.label}</span>
                    <strong>{metric.value}</strong>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>

        <div class="decision-band">
          <span>Management decision</span>
          <p>
            Do not force weak models into production. Enrich data, re-train, optimize thresholds,
            and deploy only as controlled decision support.
          </p>
        </div>
      </section>

      <section class="section split-section">
        <div class="story-card">
          <p class="section-kicker">Business problem</p>
          <h2>The claims team cannot review every claim with the same intensity.</h2>
          <p>
            Simple claims should move through the standard process quickly. Higher-risk claims should be
            identified earlier, before they become delayed, disputed, escalated or operationally expensive.
          </p>
          <p>
            The practical question is not whether a model can classify claims. It is whether it can create a
            useful review queue without overwhelming human reviewers.
          </p>
        </div>

        <div class="story-card accent">
          <p class="section-kicker">Deployment boundary</p>
          <h2>The model supports triage. It does not make final claim decisions.</h2>
          <p>
            The final system is approved only as a review-support layer for a governed human-in-the-loop pilot.
            Human reviewers retain final decision authority.
          </p>
          <ul>
            <li>No automated approval.</li>
            <li>No automated rejection.</li>
            <li>No automatic payout decision.</li>
            <li>No legal or fraud determination without review.</li>
          </ul>
        </div>
      </section>

      <section class="section">
        <div class="section-heading wide">
          <p class="section-kicker">Final triage policy</p>
          <h2>A three-level operating model, not a binary prediction.</h2>
          <p>
            The final policy separates the main priority review queue from a small watchlist layer for
            near-threshold claims with strong business signals.
          </p>
        </div>

        <div class="policy-grid">
          <article class="policy-card green">
            <span>1</span>
            <h3>Priority human review</h3>
            <p class="rule">risk_score ≥ 0.29</p>
            <strong>850 claims</strong>
            <small>75.1% precision</small>
          </article>

          <article class="policy-card yellow">
            <span>2</span>
            <h3>Watchlist / light review</h3>
            <p class="rule">0.25 ≤ score &lt; 0.29 + strong drivers</p>
            <strong>50 claims</strong>
            <small>9 extra high-risk captured</small>
          </article>

          <article class="policy-card blue">
            <span>3</span>
            <h3>Standard processing</h3>
            <p class="rule">below watchlist criteria</p>
            <strong>2,045 claims</strong>
            <small>standard workflow</small>
          </article>
        </div>

        <div class="summary-band">
          <span>Combined priority + watchlist view</span>
          <strong>
            900 claims reviewed or monitored · 71.9% precision · 79.2% recall · 30.6% coverage
          </strong>
        </div>
      </section>

      <section id="gallery" class="section gallery-section">
        <div class="section-heading wide">
          <p class="section-kicker">Portfolio visuals</p>
          <h2>The visual evidence of the project journey.</h2>
          <p>
            The hero image already shows the readiness journey. These visuals explain how the enriched
            model works, how the operating policy is structured and how a reviewer can understand a case.
          </p>
        </div>

        <div class="gallery-grid three">
          {gallery.map((item) => (
            <article class="gallery-card">
              <button
                class="gallery-image"
                type="button"
                data-full-image={item.src}
                data-image-title={item.title}
                aria-label={`Open ${item.title}`}
              >
                <img src={item.src} alt={item.title} />
              </button>
              <div class="gallery-copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section split-section">
        <div class="story-card">
          <p class="section-kicker">Technical workflow</p>
          <h2>From raw claims to pilot governance.</h2>
          <div class="workflow-list">
            <span>Synthetic claims data</span>
            <span>Data validation</span>
            <span>Leakage-safe model dataset</span>
            <span>Baseline model</span>
            <span>Threshold analysis</span>
            <span>Data enrichment</span>
            <span>Optimized Gradient Boosting</span>
            <span>Case explanations</span>
            <span>Watchlist policy</span>
            <span>Monitoring plan</span>
          </div>
        </div>

        <div class="story-card">
          <p class="section-kicker">Core stack</p>
          <h2>Applied ML with business-facing controls.</h2>
          <div class="stack-list">
            {stack.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-heading wide">
          <p class="section-kicker">What this project proves</p>
          <h2>The value is the full applied Data Science decision journey.</h2>
          <p>
            This is not positioned as a perfect model or an autonomous AI system. It is positioned as a realistic
            ML workflow where model performance, operational capacity and governance all matter.
          </p>
        </div>

        <div class="outputs-grid">
          {proofPoints.map((output) => (
            <div class="output-item">
              <span>✓</span>
              <p>{output}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section split-section">
        <div class="story-card">
          <p class="section-kicker">Explainability</p>
          <h2>Reviewers get reasons, not just scores.</h2>
          <p>
            The case-level explanation layer translates model outputs into reviewer-friendly business
            drivers: urgency, contradictions, legal language, missing documentation, third-party involvement,
            document quality and early lifecycle risk signals.
          </p>
          <p>
            The explanations are not causal proof. They are operational context for a human reviewer during
            a controlled rollout.
          </p>
        </div>

        <div class="story-card">
          <p class="section-kicker">Monitoring</p>
          <h2>The pilot has explicit stop conditions.</h2>
          <p>
            Weekly monitoring tracks review queue volume, precision, recall, false negatives, score
            distribution, data quality, enrichment health and reviewer feedback.
          </p>
          <p>
            The pilot should pause if precision falls below 55%, recall falls below 70%, enrichment failures
            exceed 5%, or the priority queue exceeds 40% for two consecutive weeks.
          </p>
        </div>
      </section>

      <section class="section files-section">
        <div class="section-heading wide">
          <p class="section-kicker">Repository evidence</p>
          <h2>Three files that document the decision.</h2>
          <p>
            The full repository includes datasets, scripts and reports. These are the three most important
            evidence files for understanding the final recommendation.
          </p>
        </div>

        <div class="file-list">
          {files.map((file) => (
            <code>{file}</code>
          ))}
        </div>
      </section>

      <section class="final-section">
        <div>
          <p class="section-kicker">Business conclusion</p>
          <h2>
            The strongest signal is not only the model performance. It is the full readiness journey.
          </h2>
          <p>
            This project demonstrates how to move from a weak-but-promising model to a governed review-support rollout:
            identify the limitation, enrich the data, re-train, optimize thresholds, add explanations,
            define monitoring and keep humans in control.
          </p>
        </div>
      </section>
    </main>

    <div class="image-modal" id="image-modal" aria-hidden="true">
      <div class="modal-backdrop" data-close-modal></div>
      <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="image-modal-title">
        <button class="modal-close" type="button" data-close-modal aria-label="Close image modal">×</button>
        <h2 id="image-modal-title"></h2>
        <img id="image-modal-img" src="" alt="" />
      </div>
    </div>

    <script>
      const modal = document.getElementById("image-modal");
      const modalImg = document.getElementById("image-modal-img");
      const modalTitle = document.getElementById("image-modal-title");

      const openButtons = document.querySelectorAll("[data-full-image]");
      const closeButtons = document.querySelectorAll("[data-close-modal]");

      function openModal(src: string, imageTitle: string) {
        if (!modal || !modalImg || !modalTitle) return;

        modalImg.setAttribute("src", src);
        modalImg.setAttribute("alt", imageTitle);
        modalTitle.textContent = imageTitle;
        modal.setAttribute("aria-hidden", "false");
        document.body.classList.add("modal-open");
      }

      function closeModal() {
        if (!modal || !modalImg) return;

        modal.setAttribute("aria-hidden", "true");
        modalImg.setAttribute("src", "");
        document.body.classList.remove("modal-open");
      }

      openButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const src = button.getAttribute("data-full-image");
          const imageTitle = button.getAttribute("data-image-title") || "Project image";

          if (!src) return;
          openModal(src, imageTitle);
        });
      });

      closeButtons.forEach((button) => {
        button.addEventListener("click", closeModal);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeModal();
        }
      });

      const revealTargets = document.querySelectorAll(
        ".section, .final-section, .metric-card, .phase-card, .story-card, .policy-card, .gallery-card, .output-item, .decision-band, .summary-band, .comparison-table"
      );

      revealTargets.forEach((element, index) => {
        element.classList.add("reveal-on-scroll");
        element.setAttribute(
          "style",
          `${element.getAttribute("style") || ""}; --reveal-delay: ${Math.min(index * 28, 220)}ms;`
        );
      });

      const revealObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              revealObserver.unobserve(entry.target);
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -8% 0px",
        }
      );

      revealTargets.forEach((element) => revealObserver.observe(element));
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(circle at 20% 10%, rgba(56, 189, 248, 0.08), transparent 28rem),
      radial-gradient(circle at 80% 20%, rgba(52, 211, 153, 0.07), transparent 26rem),
      #07111f;
    color: #e5e7eb;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(body.modal-open) {
    overflow: hidden;
  }

  .project-page {
    min-height: 100vh;
    overflow: hidden;
  }

  .hero-section {
    padding: 32px 24px 88px;
  }

  .hero-inner,
  .section,
  .final-section {
    width: min(1180px, calc(100vw - 40px));
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 38px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
    transition: color 180ms ease, transform 180ms ease;
  }

  .back-link:hover {
    color: #67e8f9;
    transform: translateX(-3px);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 0.94fr 1.06fr;
    gap: 40px;
    align-items: center;
  }

  .eyebrow,
  .section-kicker {
    margin: 0 0 14px;
    color: #67e8f9;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 18px;
    max-width: 720px;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .hero-subtitle {
    max-width: 720px;
    margin-bottom: 22px;
    color: #d1d5db;
    font-size: clamp(19px, 2vw, 25px);
    line-height: 1.35;
  }

  .hero-description {
    max-width: 760px;
    margin-top: 24px;
    color: #9ca3af;
    font-size: 16px;
    line-height: 1.7;
  }

  .hero-problem {
    position: relative;
    overflow: hidden;
    margin-top: 22px;
    border: 1px solid rgba(103, 232, 249, 0.24);
    border-radius: 22px;
    padding: 18px 20px;
    background: rgba(8, 32, 52, 0.46);
  }

  .hero-problem span {
    display: block;
    margin-bottom: 8px;
    color: #67e8f9;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-problem p {
    margin: 0;
    color: #d1d5db;
    line-height: 1.6;
  }

  .hero-tags,
  .stack-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .hero-tags span,
  .stack-list span {
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 999px;
    padding: 9px 13px;
    background: rgba(15, 23, 42, 0.52);
    color: #cbd5e1;
    font-size: 13px;
    font-weight: 700;
    transition:
      transform 220ms ease,
      border-color 220ms ease,
      color 220ms ease,
      background 220ms ease;
  }

  .hero-tags span:hover,
  .stack-list span:hover {
    transform: translateY(-2px);
    border-color: rgba(103, 232, 249, 0.55);
    color: #e0f2fe;
    background: rgba(8, 47, 73, 0.42);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 30px;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 46px;
    border-radius: 999px;
    padding: 0 20px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 800;
    transition:
      transform 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease,
      background 220ms ease;
  }

  .primary-button {
    background: linear-gradient(135deg, #38bdf8, #34d399);
    color: #06111f;
  }

  .secondary-button {
    border: 1px solid rgba(103, 232, 249, 0.55);
    color: #67e8f9;
    background: rgba(15, 23, 42, 0.45);
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-2px);
  }

  .primary-button:hover {
    box-shadow: 0 18px 44px rgba(56, 189, 248, 0.2);
  }

  .secondary-button:hover {
    border-color: rgba(103, 232, 249, 0.9);
    background: rgba(8, 47, 73, 0.38);
  }

  .hero-image-card,
  .gallery-image {
    width: 100%;
    border: 0;
    padding: 0;
    cursor: pointer;
    background: transparent;
  }

  .hero-image-card {
    overflow: hidden;
    border: 1px solid rgba(103, 232, 249, 0.28);
    border-radius: 28px;
    background: rgba(8, 18, 32, 0.8);
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.45);
    transition:
      transform 300ms ease,
      border-color 300ms ease,
      box-shadow 300ms ease;
  }

  .hero-image-card:hover {
    transform: translateY(-5px);
    border-color: rgba(103, 232, 249, 0.48);
    box-shadow: 0 34px 100px rgba(0, 0, 0, 0.5);
  }

  .hero-image-card img,
  .gallery-image img {
    display: block;
    width: 100%;
    height: auto;
    transition:
      transform 500ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 300ms ease,
      filter 300ms ease;
  }

  .hero-image-card:hover img,
  .gallery-image:hover img {
    transform: scale(1.025);
    opacity: 0.96;
    filter: saturate(1.08);
  }

  .section {
    padding: 82px 0;
  }

  .compact-section {
    padding-top: 40px;
  }

