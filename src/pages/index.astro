  .case-top-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        180deg,
        rgba(5, 11, 24, 0.18) 0%,
        rgba(6, 13, 28, 0.34) 28%,
        rgba(6, 13, 28, 0.7) 64%,
