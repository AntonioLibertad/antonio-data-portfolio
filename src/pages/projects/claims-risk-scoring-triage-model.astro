  .section-kicker {
    margin: 0 0 14px;
    color: #67e8f9;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p {
    margin-top: 0;
  }

  h1 {
    margin-bottom: 18px;
    max-width: 720px;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .hero-subtitle {
    max-width: 720px;
    margin-bottom: 22px;
    color: #d1d5db;
    font-size: clamp(19px, 2vw, 25px);
    line-height: 1.35;
  }

  .hero-description {
    max-width: 760px;
    margin-top: 24px;
