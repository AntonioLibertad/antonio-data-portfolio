    <script is:inline>

      
  const resumeDropdown = document.querySelector(".resume-dropdown");
  const resumeButton = document.querySelector(".resume-dropdown-button");

  if (resumeDropdown instanceof HTMLElement && resumeButton instanceof HTMLButtonElement) {
    resumeButton.addEventListener("click", (event) => {
      event.stopPropagation();

      const isCurrentlyOpen = resumeDropdown.classList.contains("is-open");

      if (isCurrentlyOpen) {
        resumeDropdown.classList.remove("is-open");
        resumeButton.setAttribute("aria-expanded", "false");
        resumeButton.blur();
      } else {
        resumeDropdown.classList.add("is-open");
        resumeButton.setAttribute("aria-expanded", "true");
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;

      if (!(target instanceof Node)) return;

      if (!resumeDropdown.contains(target)) {
        resumeDropdown.classList.remove("is-open");
        resumeButton.setAttribute("aria-expanded", "false");
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        resumeDropdown.classList.remove("is-open");
        resumeButton.setAttribute("aria-expanded", "false");
        resumeButton.blur();
      }
    });
  }


      const galleryItems = [
        {
          src: "/dashboard-overview.png",
          alt: "General business overview dashboard",
          title: "General business overview",
          caption:
            "A high-level commercial view of revenue, customers, repeat purchasing, ticket size, and channel distribution.",
        },
        {
          src: "/dashboard-segmentation.png",
          alt: "Customer segmentation dashboard",
          title: "Customer segmentation",
          caption:
            "Segment-level visibility to understand revenue concentration, customer mix, and reactivation opportunities.",
        },
        {
          src: "/dashboard-trends.png",
          alt: "Trend analysis dashboard",
          title: "Trends and drivers",
          caption:
            "Month-over-month and year-over-year performance tracking to explain changes and identify commercial drivers.",
        },
        {
          src: "/dashboard-recommendations.png",
          alt: "Recommendation system dashboard",
          title: "Recommendations and actionability",
          caption:
            "An explainable recommendation layer designed to move the project beyond reporting and towards practical decision support.",
        },
      ];

      let currentGalleryIndex = 0;
      let galleryTransitionTimeout;

      const galleryImage = document.getElementById("dashboard-gallery-image");
      const galleryTitle = document.getElementById("dashboard-gallery-title");
      const galleryCaption = document.getElementById("dashboard-gallery-caption");
      const galleryPrev = document.getElementById("gallery-prev");
      const galleryNext = document.getElementById("gallery-next");
      const galleryThumbs = Array.from(document.querySelectorAll(".gallery-thumb"));
      const galleryStage = document.querySelector(".gallery-stage");
      const galleryMeta = document.querySelector(".gallery-meta");
      const openPipelineModalBtn = document.getElementById("open-pipeline-modal");

      const galleryModal = document.getElementById("gallery-modal");
      const pipelineModal = document.getElementById("pipeline-modal");
      const galleryModalImage = document.getElementById("gallery-modal-image");
      const galleryModalTitle = document.getElementById("gallery-modal-title");
      const galleryModalText = document.getElementById("gallery-modal-text");

      const projectFilterButtons = Array.from(document.querySelectorAll("[data-project-filter]"));
      const projectTrack = document.getElementById("projects-carousel-track");
      const projectPrev = document.getElementById("projects-carousel-prev");
      const projectNext = document.getElementById("projects-carousel-next");

      let activeProjectFilter = "all";
      let projectCurrentPage = 0;

      function applyGalleryContent(index) {
        currentGalleryIndex = index;
        const item = galleryItems[index];

        if (galleryImage) {
          galleryImage.src = item.src;
          galleryImage.alt = item.alt;
        }

        if (galleryTitle) galleryTitle.textContent = item.title;
        if (galleryCaption) galleryCaption.textContent = item.caption;

        if (galleryModalImage) {
          galleryModalImage.src = item.src;
          galleryModalImage.alt = item.alt;
        }

        if (galleryModalTitle) galleryModalTitle.textContent = item.title;
        if (galleryModalText) galleryModalText.textContent = item.caption;

        galleryThumbs.forEach((thumb, thumbIndex) => {
          const isActive = thumbIndex === index;
          thumb.classList.toggle("is-active", isActive);
          thumb.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      }

      function renderGallery(index, withTransition = true) {
        const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!withTransition || prefersReducedMotion || !galleryStage || !galleryMeta) {
          applyGalleryContent(index);
          return;
        }

        galleryStage.classList.add("is-switching");
        galleryMeta.classList.add("is-switching");
        clearTimeout(galleryTransitionTimeout);

        galleryTransitionTimeout = window.setTimeout(() => {
          applyGalleryContent(index);
          requestAnimationFrame(() => {
            galleryStage.classList.remove("is-switching");
            galleryMeta.classList.remove("is-switching");
          });
        }, 130);
      }

      function openModal(modal) {
        if (!modal) return;
        modal.classList.add("is-open");
        document.body.style.overflow = "hidden";
      }

      function closeModal(modal) {
        if (!modal) return;
        modal.classList.remove("is-open");
        document.body.style.overflow = "";
      }

      function goToPreviousGalleryItem() {
        const nextIndex = (currentGalleryIndex - 1 + galleryItems.length) % galleryItems.length;
        renderGallery(nextIndex, true);
      }

      function goToNextGalleryItem() {
        const nextIndex = (currentGalleryIndex + 1) % galleryItems.length;
        renderGallery(nextIndex, true);
      }

      function getVisibleProjectCards() {
        if (!projectTrack) return [];
        return Array.from(projectTrack.querySelectorAll(".project-carousel-card-link")).filter((card) => {
          return !card.classList.contains("is-hidden");
        });
      }

      function getProjectsPerView() {
        if (window.innerWidth <= 760) return 1;
        if (window.innerWidth <= 1080) return 2;
        return 3;
      }
      function sortProjectCardsForActiveFilter() {
        if (!projectTrack) return;

        const cards = Array.from(projectTrack.querySelectorAll(".project-carousel-card-link"));

        const priorityDatasetKeys = {
          "data-analyst-bi": "priorityDataAnalystBi",
          "business-analyst": "priorityBusinessAnalyst",
          "fpa-controlling": "priorityFpaControlling",
          "data-science-ai": "priorityDataScienceAi",
        };

        const sortedCards = [...cards].sort((a, b) => {
          const originalA = Number(a.dataset.originalIndex || 999);
          const originalB = Number(b.dataset.originalIndex || 999);

          if (activeProjectFilter === "all") {
            return originalA - originalB;
          }

          const priorityKey = priorityDatasetKeys[activeProjectFilter];
          const priorityA = Number(a.dataset[priorityKey] || 999);
          const priorityB = Number(b.dataset[priorityKey] || 999);

          if (priorityA !== priorityB) {
            return priorityA - priorityB;
          }

          return originalA - originalB;
        });

        sortedCards.forEach((card) => {
          projectTrack.appendChild(card);
        });
      }

      function updateFeaturedProjectCardStyle() {
        if (!projectTrack) return;

        const allCards = Array.from(projectTrack.querySelectorAll(".project-carousel-card-link"));
        const visibleCards = allCards.filter((card) => !card.classList.contains("is-hidden"));

        allCards.forEach((card) => {
          card.querySelector(".project-carousel-card")?.classList.remove("project-carousel-card--featured");
        });

        visibleCards[0]
          ?.querySelector(".project-carousel-card")
          ?.classList.add("project-carousel-card--featured");
      }

      function updateProjectCardsVisibility() {
        if (!projectTrack) return;

        sortProjectCardsForActiveFilter();

        const cards = Array.from(projectTrack.querySelectorAll(".project-carousel-card-link"));

        cards.forEach((card) => {
          const tracks = (card.dataset.projectTracks || "").split(" ").filter(Boolean);
          const shouldShow = activeProjectFilter === "all" || tracks.includes(activeProjectFilter);

          card.classList.toggle("is-hidden", !shouldShow);
        });

        updateFeaturedProjectCardStyle();

        projectCurrentPage = 0;
        updateProjectCarousel();
      }

      function updateProjectFilterButtons() {
        projectFilterButtons.forEach((button) => {
          const isActive = button.dataset.projectFilter === activeProjectFilter;
          button.classList.toggle("is-active", isActive);
          button.setAttribute("aria-pressed", isActive ? "true" : "false");
        });
      }

      function updateProjectCarousel() {
        if (!projectTrack) return;

        const visibleCards = getVisibleProjectCards();
        const perView = getProjectsPerView();
        const maxPage = Math.max(0, Math.ceil(visibleCards.length / perView) - 1);

        if (projectCurrentPage > maxPage) {
          projectCurrentPage = maxPage;
        }

        visibleCards.forEach((card, index) => {
          const page = Math.floor(index / perView);
          card.classList.toggle("is-page-hidden", page !== projectCurrentPage);
        });

        const allCards = Array.from(projectTrack.querySelectorAll(".project-carousel-card-link"));
        allCards.forEach((card) => {
          if (card.classList.contains("is-hidden")) {
            card.classList.add("is-page-hidden");
          }
        });

        if (projectPrev) projectPrev.disabled = projectCurrentPage === 0;
        if (projectNext) projectNext.disabled = projectCurrentPage >= maxPage;
      }

      projectFilterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          activeProjectFilter = button.dataset.projectFilter || "all";
          updateProjectFilterButtons();
          updateProjectCardsVisibility();
        });
      });

      projectPrev?.addEventListener("click", () => {
        if (projectCurrentPage > 0) {
          projectCurrentPage -= 1;
          updateProjectCarousel();
        }
      });

      projectNext?.addEventListener("click", () => {
        const visibleCards = getVisibleProjectCards();
        const perView = getProjectsPerView();
        const maxPage = Math.max(0, Math.ceil(visibleCards.length / perView) - 1);

        if (projectCurrentPage < maxPage) {
          projectCurrentPage += 1;
          updateProjectCarousel();
        }
      });

      galleryPrev?.addEventListener("click", goToPreviousGalleryItem);
      galleryNext?.addEventListener("click", goToNextGalleryItem);

      galleryThumbs.forEach((thumb, index) => {
        thumb.addEventListener("click", () => renderGallery(index, true));
      });

      galleryImage?.addEventListener("click", () => {
        applyGalleryContent(currentGalleryIndex);
        openModal(galleryModal);
      });

      openPipelineModalBtn?.addEventListener("click", () => {
        openModal(pipelineModal);
      });

      document.querySelectorAll("[data-close-modal]").forEach((button) => {
        button.addEventListener("click", () => {
          closeModal(button.closest(".media-modal"));
        });
      });

      document.querySelectorAll(".media-modal").forEach((modal) => {
        modal.addEventListener("click", (event) => {
          if (event.target === modal) {
            closeModal(modal);
          }
        });
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeModal(galleryModal);
          closeModal(pipelineModal);
        }

        if (event.key === "ArrowLeft" && !galleryModal?.classList.contains("is-open")) {
          goToPreviousGalleryItem();
        }

        if (event.key === "ArrowRight" && !galleryModal?.classList.contains("is-open")) {
          goToNextGalleryItem();
        }
      });

      const revealItems = Array.from(document.querySelectorAll(".reveal"));
      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      function revealImmediately() {
        revealItems.forEach((item) => item.classList.add("is-visible"));
      }

      if (prefersReducedMotion.matches) {
        revealImmediately();
      } else {
        const revealObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          {
            threshold: 0.16,
            rootMargin: "0px 0px -10% 0px",
          }
        );

        revealItems.forEach((item) => revealObserver.observe(item));
      }

      window.addEventListener("resize", updateProjectCarousel);

      renderGallery(0, false);
      updateProjectFilterButtons();
      updateProjectCardsVisibility();
    </script>
  </body>
</html>

