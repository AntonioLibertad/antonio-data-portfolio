  {
    href: "/projects/commercial-margin-protection",
    image: "/commercial-margin-protection/overview.png",
    imageAlt: "Preview of the Commercial Margin Protection & Pricing Analytics project",
    eyebrow: "Commercial Analytics / Pricing / Margin",
    badge: "Management-facing case",
    title: "Commercial Margin Protection & Pricing Analytics",
    description:
      "A business-facing analytics case focused on discount leakage, returns, weak price realization, and margin pressure in an omnichannel retail business.",
    highlights: [
      "5-page Power BI suite",
      "Pricing + returns + margin logic",
      "Action prioritization",
    ],
    tracks: ["data-analyst-bi", "business-analyst", "fpa-controlling"],
    priorityByTrack: {
  "data-analyst-bi": 3,
  "business-analyst": 6,
