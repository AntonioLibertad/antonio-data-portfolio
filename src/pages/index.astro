    badge: "Finance data case",
    title: "Finance Data Foundation for FP&A and Controlling",
    description:
      "Finance-focused analytics project designed to demonstrate source-to-target logic, variance analysis, reconciliation controls, and stakeholder-facing reporting.",
    highlights: [
      "4-page Power BI suite",
      "Variance & controls",
      "DuckDB + parquet layers",
    ],
    tracks: ["data-analyst-bi", "business-analyst", "fpa-controlling"],
    priorityByTrack: {
  "data-analyst-bi": 8,
