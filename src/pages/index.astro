---
const siteTitle = "Antonio González Martín | Data Portfolio";
const siteDescription =
  "Portfolio focused on applied analytics, decision support, and business-facing data projects.";

type ProjectTrack =
  | "data-analyst-bi"
  | "business-analyst"
  | "fpa-controlling"
  | "data-science-ai";

type ProjectFilter = "all" | ProjectTrack;

const trackLabels: Record<ProjectTrack, string> = {
  "data-analyst-bi": "Data Analyst / BI",
  "business-analyst": "Business Analyst",
  "fpa-controlling": "FP&A / Controlling",
  "data-science-ai": "Data Science / AI",
};

type FeaturedProject = {
  href: string;
  image: string;
  imageAlt: string;
  eyebrow: string;
  badge: string;
  title: string;
  description: string;
  highlights: string[];
  tracks: ProjectTrack[];
  priorityByTrack?: Partial<Record<ProjectTrack, number>>;
  cta: string;
};

const featuredProjects: FeaturedProject[] = [
  {
    href: "/projects/service-request-workflow-control-prioritisation",
    image: "/images/projects/ba-workflow/ba-workflow-powerbi-executive-overview.png",
    imageAlt: "Preview of the Service Request Workflow Control & Prioritisation Power BI dashboard",
    eyebrow: "Business Analysis / Workflow Control / Process Improvement",
    badge: "New BA workflow case",
    title: "Service Request Workflow Control & Prioritisation",
    description:
      "A Business Analyst case showing how fragmented internal service request intake can be translated into structured requirements, validation rules, workflow controls, KPI reporting, and prioritised management action.",
    highlights: [
      "AS-IS / TO-BE workflow",
      "Requirements + UAT logic",
      "Power BI action prioritisation",
    ],
    tracks: ["business-analyst", "data-analyst-bi"],
    priorityByTrack: {
      "business-analyst": 1,
      "data-analyst-bi": 5,
    },
    cta: "Open BA workflow case study",
  },
  {
    href: "/projects/diagnostic-lab-performance-sla-analytics",
    image: "/images/projects/diagnostic-lab/diagnostic-lab-overview.png",
    imageAlt: "Preview of the Diagnostic Lab Performance & SLA Analytics Power BI dashboard",
    eyebrow: "Healthcare Analytics / SLA / Operations",
    badge: "New healthcare analytics case",
