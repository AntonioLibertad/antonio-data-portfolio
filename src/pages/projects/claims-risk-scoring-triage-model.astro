---
const project = {
  title: "Claims Risk Scoring & Triage Model",
  eyebrow: "Applied ML / Insurance Analytics / Human-in-the-Loop AI",
  subtitle:
    "A claims risk scoring system that moves from an intake-only baseline model to an enriched, explainable, controlled-pilot-ready triage workflow.",
  description:
    "Built around a realistic insurance claims problem: the first model had useful signal but was not deployment-ready. Instead of forcing it into production, the workflow simulates shadow-mode learning, enriches the data with LLM-style text signals, document quality, provider history and early lifecycle indicators, then optimizes a Gradient Boosting model for controlled human review.",
  heroImage:
    "/images/projects/claims-risk-scoring-triage/01_model_readiness_journey.png",
};

const gallery = [
  {
    src: "/images/projects/claims-risk-scoring-triage/01_model_readiness_journey.png",
    title: "Model readiness journey",
    description:
      "The first intake-only model was useful but not deployment-ready. The enriched model reaches controlled pilot criteria.",
  },
  {
    src: "/images/projects/claims-risk-scoring-triage/03_enriched_feature_architecture.png",
    title: "Enriched feature architecture",
    description:
      "LLM-style text signals, document quality, provider history and early lifecycle signals improve risk separation.",
  },
  {
    src: "/images/projects/claims-risk-scoring-triage/02_final_triage_policy.png",
    title: "Final triage operating model",
    description:
      "Priority review, watchlist/light review and standard processing are separated into clear operational layers.",
  },
  {
    src: "/images/projects/claims-risk-scoring-triage/04_case_level_explainability.png",
    title: "Case-level explainability",
    description:
      "Reviewer-friendly explanations translate model scores into understandable business drivers.",
  },
];

const finalMetrics = [
  { label: "ROC-AUC", value: "0.907", tone: "blue" },
  { label: "Precision", value: "75.1%", tone: "green" },
  { label: "Recall", value: "78.1%", tone: "green" },
  { label: "Review queue", value: "28.9%", tone: "cyan" },
];

const phases = [
  {
    phase: "Phase 1",
    title: "Intake-only model",
    status: "Not deployment-ready",
    statusTone: "red",
    text: "The first model used only claim intake data. It had useful signal, but the review queue was too broad and not clean enough to justify operational deployment.",
    metrics: [
      { label: "Precision", value: "50.2%" },
      { label: "Recall", value: "72.0%" },
      { label: "Queue", value: "39.8%" },
    ],
  },
  {
    phase: "Phase 2",
    title: "Enriched optimized model",
    status: "Controlled pilot ready",
    statusTone: "green",
    text: "The second iteration enriched the feature layer with LLM-style text risk signals, document quality, provider history and early lifecycle indicators.",
    metrics: [
      { label: "Precision", value: "75.1%" },
      { label: "Recall", value: "78.1%" },
      { label: "Queue", value: "28.9%" },
    ],
  },
];

const stack = [
  "Python",
  "Pandas",
  "Scikit-learn",
  "Gradient Boosting",
  "Feature Engineering",
  "Threshold Analysis",
  "LLM-style Text Signals",
  "Model Monitoring",
  "Human-in-the-Loop AI",
];

const outputs = [
  "Synthetic claims dataset with realistic operational risk patterns",
  "Data validation and leakage-safe modelling dataset",
  "Baseline model, threshold analysis and hybrid policy testing",
  "Enriched feature layer with text, document, provider and early lifecycle signals",
  "Optimized Gradient Boosting model selected by business-aware criteria",
  "Case-level explanations for claim reviewers",
  "Watchlist policy for near-threshold claims",
  "Controlled pilot monitoring plan and model readiness report",
];

const files = [
  "reports/final_model_readiness_report.md",
  "reports/controlled_pilot_monitoring_plan.md",
  "reports/gradient_boosting_optimization_report.md",
  "reports/case_level_explainability_report.md",
  "reports/watchlist_policy_report.md",
  "data/processed/final_claim_triage_explanations_with_watchlist.csv",
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{project.title} | Antonio Libertad</title>
    <meta
      name="description"
      content="Applied ML claims risk scoring project with enriched feature engineering, explainability, monitoring and controlled pilot governance."
    />
  </head>

  <body>
    <main class="project-page">
      <section class="hero-section">
        <div class="hero-inner">
          <a class="back-link" href="/">← Back to portfolio</a>

          <div class="hero-grid">
            <div class="hero-copy">
              <p class="eyebrow">{project.eyebrow}</p>
              <h1>{project.title}</h1>
              <p class="hero-subtitle">{project.subtitle}</p>

              <div class="hero-tags">
                <span>Data Science / AI</span>
                <span>Risk Analytics</span>
                <span>Human-in-the-loop</span>
              </div>

              <p class="hero-description">{project.description}</p>

              <div class="hero-actions">
                <a href="#readiness" class="primary-button">View model journey</a>
                <a href="#gallery" class="secondary-button">View visuals</a>
              </div>
            </div>

            <button
              class="hero-image-card"
              type="button"
              data-full-image={project.heroImage}
              data-image-title="Model readiness journey"
              aria-label="Open model readiness journey image"
            >
              <img src={project.heroImage} alt="Model readiness journey visual" />
            </button>
          </div>
        </div>
      </section>

      <section class="section metrics-section">
        <div class="section-heading">
          <p class="section-kicker">Final operating point</p>
          <h2>Controlled pilot ready, not automated decision-making.</h2>
          <p>
            The optimized Gradient Boosting model meets the target operating criteria for a controlled
            human-in-the-loop pilot. The model prioritizes review; it does not approve, reject or settle claims.
          </p>
        </div>

        <div class="metric-grid">
          {finalMetrics.map((metric) => (
            <article class={`metric-card ${metric.tone}`}>
              <span>{metric.label}</span>
              <strong>{metric.value}</strong>
            </article>
          ))}
        </div>
      </section>

      <section id="readiness" class="section">
        <div class="section-heading wide">
          <p class="section-kicker">Model readiness journey</p>
          <h2>The important part is not just the final model. It is the decision process.</h2>
          <p>
            The first model was not forced into production. The project treats that result as a readiness
            decision, then simulates the next realistic step: shadow-mode learning and better data signal.
          </p>
        </div>

        <div class="phase-grid">
          {phases.map((phase) => (
            <article class={`phase-card ${phase.statusTone}`}>
              <div class="phase-topline">
                <span>{phase.phase}</span>
                <strong>{phase.status}</strong>
              </div>
              <h3>{phase.title}</h3>
              <p>{phase.text}</p>

              <div class="phase-metrics">
                {phase.metrics.map((metric) => (
                  <div>
                    <span>{metric.label}</span>
                    <strong>{metric.value}</strong>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>

        <div class="decision-band">
          <span>Management decision</span>
          <p>
            Do not force weak models into production. Enrich data, re-train, optimize thresholds,
            and deploy only as controlled decision support.
          </p>
        </div>
      </section>

      <section class="section split-section">
        <div class="story-card">
          <p class="section-kicker">Business problem</p>
          <h2>The claims team cannot review every claim with the same intensity.</h2>
          <p>
            Simple claims should move through the standard process quickly. Higher-risk claims should be
            identified earlier, before they become delayed, disputed, escalated or operationally expensive.
          </p>
          <p>
            The practical question is not whether a model can classify claims. It is whether it can create a
            useful review queue without overwhelming human reviewers.
          </p>
        </div>

        <div class="story-card accent">
          <p class="section-kicker">Deployment boundary</p>
          <h2>The model supports triage. It does not make final claim decisions.</h2>
          <p>
            The final system is approved only as a controlled pilot for priority human review support.
            Human reviewers retain final decision authority.
          </p>
          <ul>
            <li>No automated approval.</li>
            <li>No automated rejection.</li>
            <li>No automatic payout decision.</li>
            <li>No legal or fraud determination without review.</li>
          </ul>
        </div>
      </section>

      <section class="section">
        <div class="section-heading wide">
          <p class="section-kicker">Final triage policy</p>
          <h2>A three-level operating model, not a binary prediction.</h2>
          <p>
            The final policy separates the main priority review queue from a small watchlist layer for
            near-threshold claims with strong business signals.
          </p>
        </div>

        <div class="policy-grid">
          <article class="policy-card green">
            <span>1</span>
            <h3>Priority human review</h3>
            <p class="rule">risk_score ≥ 0.29</p>
            <strong>850 claims</strong>
            <small>75.1% precision</small>
          </article>

          <article class="policy-card yellow">
            <span>2</span>
            <h3>Watchlist / light review</h3>
            <p class="rule">0.25 ≤ score &lt; 0.29 + strong drivers</p>
            <strong>50 claims</strong>
            <small>9 extra high-risk captured</small>
          </article>

          <article class="policy-card blue">
            <span>3</span>
            <h3>Standard processing</h3>
            <p class="rule">below watchlist criteria</p>
            <strong>2,045 claims</strong>
            <small>standard workflow</small>
          </article>
        </div>

        <div class="summary-band">
          <span>Combined priority + watchlist view</span>
          <strong>
            900 claims reviewed or monitored · 71.9% precision · 79.2% recall · 30.6% coverage
          </strong>
        </div>
      </section>

      <section id="gallery" class="section gallery-section">
        <div class="section-heading wide">
          <p class="section-kicker">Portfolio visuals</p>
          <h2>The visual evidence of the project journey.</h2>
          <p>
            These visuals are designed to explain the business journey quickly: model readiness, enriched
            architecture, final policy and case-level explainability.
          </p>
        </div>

        <div class="gallery-grid">
          {gallery.map((item) => (
            <article class="gallery-card">
              <button
                class="gallery-image"
                type="button"
                data-full-image={item.src}
                data-image-title={item.title}
                aria-label={`Open ${item.title}`}
              >
                <img src={item.src} alt={item.title} />
              </button>
              <div class="gallery-copy">
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="section split-section">
        <div class="story-card">
          <p class="section-kicker">Technical workflow</p>
          <h2>From raw claims to pilot governance.</h2>
          <div class="workflow-list">
            <span>Synthetic claims data</span>
            <span>Data validation</span>
            <span>Leakage-safe model dataset</span>
            <span>Baseline model</span>
            <span>Threshold analysis</span>
            <span>Data enrichment</span>
            <span>Optimized Gradient Boosting</span>
            <span>Case explanations</span>
            <span>Watchlist policy</span>
            <span>Monitoring plan</span>
          </div>
        </div>

        <div class="story-card">
          <p class="section-kicker">Core stack</p>
          <h2>Applied ML with business-facing controls.</h2>
          <div class="stack-list">
            {stack.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="section-heading wide">
          <p class="section-kicker">Project outputs</p>
          <h2>What the project produces.</h2>
        </div>

        <div class="outputs-grid">
          {outputs.map((output) => (
            <div class="output-item">
              <span>✓</span>
              <p>{output}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section split-section">
        <div class="story-card">
          <p class="section-kicker">Explainability</p>
          <h2>Reviewers get reasons, not just scores.</h2>
          <p>
            The case-level explanation layer translates model outputs into reviewer-friendly business
            drivers: urgency, contradictions, legal language, missing documentation, third-party involvement,
            document quality and early lifecycle risk signals.
          </p>
          <p>
            The explanations are not causal proof. They are operational context for a human reviewer during
            a controlled pilot.
          </p>
        </div>

        <div class="story-card">
          <p class="section-kicker">Monitoring</p>
          <h2>The pilot has explicit stop conditions.</h2>
          <p>
            Weekly monitoring tracks review queue volume, precision, recall, false negatives, score
            distribution, data quality, enrichment health and reviewer feedback.
          </p>
          <p>
            The pilot should pause if precision falls below 55%, recall falls below 70%, enrichment failures
            exceed 5%, or the priority queue exceeds 40% for two consecutive weeks.
          </p>
        </div>
      </section>

      <section class="section files-section">
        <div class="section-heading wide">
          <p class="section-kicker">Key files</p>
          <h2>Evidence available in the repository.</h2>
        </div>

        <div class="file-list">
          {files.map((file) => (
            <code>{file}</code>
          ))}
        </div>
      </section>

      <section class="final-section">
        <div>
          <p class="section-kicker">Business conclusion</p>
          <h2>
            The strongest signal is not only the model performance. It is the full readiness journey.
          </h2>
          <p>
            This project demonstrates how to move from a weak-but-promising model to a controlled pilot:
            identify the limitation, enrich the data, re-train, optimize thresholds, add explanations,
            define monitoring, and keep humans in control.
          </p>
        </div>
      </section>
    </main>

    <div class="image-modal" id="image-modal" aria-hidden="true">
      <div class="modal-backdrop" data-close-modal></div>
      <div class="modal-content" role="dialog" aria-modal="true" aria-labelledby="image-modal-title">
        <button class="modal-close" type="button" data-close-modal aria-label="Close image modal">×</button>
        <h2 id="image-modal-title"></h2>
        <img id="image-modal-img" src="" alt="" />
      </div>
    </div>

    <script>
      const modal = document.getElementById("image-modal");
      const modalImg = document.getElementById("image-modal-img");
      const modalTitle = document.getElementById("image-modal-title");

      const openButtons = document.querySelectorAll("[data-full-image]");
      const closeButtons = document.querySelectorAll("[data-close-modal]");

      function openModal(src: string, imageTitle: string) {
        if (!modal || !modalImg || !modalTitle) return;

        modalImg.setAttribute("src", src);
        modalImg.setAttribute("alt", imageTitle);
        modalTitle.textContent = imageTitle;
        modal.setAttribute("aria-hidden", "false");
        document.body.classList.add("modal-open");
      }

      function closeModal() {
        if (!modal || !modalImg) return;

        modal.setAttribute("aria-hidden", "true");
        modalImg.setAttribute("src", "");
        document.body.classList.remove("modal-open");
      }

      openButtons.forEach((button) => {
        button.addEventListener("click", () => {
          const src = button.getAttribute("data-full-image");
          const imageTitle = button.getAttribute("data-image-title") || "Project image";

          if (!src) return;
          openModal(src, imageTitle);
        });
      });

      closeButtons.forEach((button) => {
        button.addEventListener("click", closeModal);
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
          closeModal();
        }
      });
    </script>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    background:
      radial-gradient(circle at 20% 10%, rgba(56, 189, 248, 0.08), transparent 28rem),
      radial-gradient(circle at 80% 20%, rgba(52, 211, 153, 0.07), transparent 26rem),
      #07111f;
    color: #e5e7eb;
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  }

  :global(body.modal-open) {
    overflow: hidden;
  }

  .project-page {
    min-height: 100vh;
    overflow: hidden;
  }

  .hero-section {
    padding: 32px 24px 88px;
  }

  .hero-inner,
  .section,
  .final-section {
    width: min(1180px, calc(100vw - 40px));
    margin: 0 auto;
  }

  .back-link {
    display: inline-flex;
    margin-bottom: 38px;
    color: #94a3b8;
    text-decoration: none;
    font-size: 14px;
