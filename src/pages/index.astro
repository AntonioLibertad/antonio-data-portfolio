  .case-top-shell {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 32px;
    background: linear-gradient(
      180deg,
      rgba(18, 30, 54, 0.82) 0%,
      rgba(18, 30, 54, 0.9) 100%
    );
    box-shadow: var(--shadow);
    margin-bottom: 1.6rem;
    backdrop-filter: blur(12px);
