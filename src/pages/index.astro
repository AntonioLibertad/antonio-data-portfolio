  "fpa-controlling": 2,
},
    cta: "Open finance case study",
  },
  {
    href: "/projects/novamarket-product-growth-experimentation-analytics",
    image: "/images/projects/novamarket/novamarket-results.png",
    imageAlt: "Preview of the NovaMarket Product Growth & Experimentation Analytics project",
    eyebrow: "Product Analytics / Experimentation / Growth",
    badge: "Product analytics case",
    title: "NovaMarket — Product Growth & Experimentation Analytics",
    description:
      "A product analytics case built around a real marketplace question: did a new discovery treatment improve user progression enough to justify selective rollout?",
    highlights: [
      "4-page Power BI story",
      "Experiment-aware analysis",
      "Selective rollout decision",
    ],
    tracks: ["data-analyst-bi", "business-analyst"],
    priorityByTrack: {
  "data-analyst-bi": 2,
  "business-analyst": 9,
},
    cta: "Open product analytics case study",
  },
  {
    href: "#flagship",
    image: "/dashboard-overview.png",
    imageAlt: "Preview of the master's flagship analytics project",
    eyebrow: "Master’s flagship project",
    badge: "",
    title: "End-to-end decision-support system for SMEs",
    description:
      "A full analytical system turning fragmented commercial data into structured visibility, segmentation, recommendation logic, and business-facing outputs.",
    highlights: [
      "Multi-source pipeline",
      "Segmentation + recommendations",
      "Decision-support design",
    ],
    tracks: ["data-analyst-bi", "business-analyst", "data-science-ai"],
    priorityByTrack: {
  "data-analyst-bi": 4,
  "business-analyst": 2,
  "data-science-ai": 4,
},
    cta: "Jump to flagship project",
  },
  {
    href: "/projects/claims-risk-scoring-triage-model",
    image: "/images/projects/claims-risk-scoring-triage/01_model_readiness_journey.png",
    imageAlt: "Premium visual showing the model readiness journey for the Claims Risk Scoring & Triage Model project",
    eyebrow: "Applied ML / Insurance Analytics / Human-in-the-loop AI",
    badge: "New ML triage case",
    title: "Claims Risk Scoring & Triage Model",
    description:
      "An applied ML case showing how a claims triage model moved from an intake-only baseline that was not deployment-ready to an enriched, explainable, human-in-the-loop pilot with threshold policy, watchlist logic, and monitoring controls.",
    highlights: [
      "Optimized Gradient Boosting",
      "LLM-style text enrichment",
      "Pilot readiness + monitoring",
    ],
    tracks: ["data-science-ai", "business-analyst"],
    priorityByTrack: {
      "data-science-ai": 1,
      "business-analyst": 6,
    },
    cta: "Open ML triage case study",
  },
  {
    href: "/projects/claims-ai-reliability-platform",
    image: "/images/projects/claims-ai-reliability/claims-reliability-control-room-critical.png",
    imageAlt: "Preview of the Claims AI Reliability Platform project",
    eyebrow: "AI Reliability / LLMOps / Governance",
    badge: "Flagship AI case",
    title: "Claims AI Reliability Platform",
    description:
      "A production-style AI reliability case built around a harder question than demo quality: when can a claims knowledge assistant be trusted enough to scale, and how should unsafe behavior be detected, reviewed, and rolled back after release?",
    highlights: [
      "Governed release gate",
      "Real bug caught and fixed",
      "Live monitoring + rollback logic",
    ],
    tracks: ["business-analyst", "data-science-ai"],
    priorityByTrack: {
  "business-analyst": 10,
  "data-science-ai": 2,
},
    cta: "Open AI reliability case study",
  },
  {
    href: "/projects/internal-policy-process-knowledge-assistant",
    image: "/images/projects/northstar/northstar-demo-home.png",
    imageAlt: "Preview of the Internal Policy & Process Knowledge Assistant project",
    eyebrow: "Applied GenAI / Retrieval / Knowledge Workflow",
    badge: "GenAI workflow case",
    title: "Internal Policy & Process Knowledge Assistant",
    description:
      "A grounded GenAI workflow built around a realistic internal operations problem: helping teams get faster, more reliable answers from scattered policies, procedures, approvals, and support documents.",
    highlights: [
      "Grounded answers",
      "Retrieval-first workflow",
      "Source-backed evidence",
    ],
    tracks: ["business-analyst", "data-science-ai"],
    priorityByTrack: {
  "business-analyst": 5,
  "data-science-ai": 3,
},
    cta: "Open GenAI case study",
  },
];

const filterOptions: { key: ProjectFilter; label: string; count: number }[] = [
  {
    key: "all",
    label: "All",
    count: featuredProjects.length,
  },
  {
    key: "data-analyst-bi",
    label: trackLabels["data-analyst-bi"],
    count: featuredProjects.filter((project) => project.tracks.includes("data-analyst-bi")).length,
  },
  {
    key: "business-analyst",
    label: trackLabels["business-analyst"],
    count: featuredProjects.filter((project) => project.tracks.includes("business-analyst")).length,
  },
  {
    key: "fpa-controlling",
    label: trackLabels["fpa-controlling"],
    count: featuredProjects.filter((project) => project.tracks.includes("fpa-controlling")).length,
  },
  {
    key: "data-science-ai",
    label: trackLabels["data-science-ai"],
    count: featuredProjects.filter((project) => project.tracks.includes("data-science-ai")).length,
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={siteDescription} />
    <title>{siteTitle}</title>
  
    <!-- Microsoft Clarity -->
    <script type="text/javascript" is:inline>
      (function(c,l,a,r,i,t,y){
          c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
          t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
          y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "wqg84gy675");
    </script>

  </head>

  <body>
    <header class="site-header">
      <div class="container nav">
        <a href="/" class="brand">Antonio González Martín</a>

        <nav class="nav-links">
          <a href="/#about">About</a>
          <a href="/#projects">Projects</a>
          <a href="/#contact">Contact</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-shell">
            <div class="hero-overlay"></div>

            <div class="hero-content hero-entrance">
              <p class="hero-eyebrow">Data Science · Business Analytics · Data Analytics</p>
              <h1>Turning data into business decisions.</h1>
              <p class="hero-subtitle">
                Applied analytics, decision support, and business-facing data projects built around
                real commercial, operational, finance, and healthcare use cases.
              </p>

              <div class="hero-actions">
                <a class="button button-primary" href="/#projects">View selected work</a>
                <a class="button button-secondary" href="/#about">About me</a>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="about" class="section about-section">
        <div class="container about-grid">
          <div class="about-photo-card reveal reveal-left">
            <img src="/profile.jpg" alt="Portrait of Antonio González Martín" loading="lazy" />
          </div>

          <div class="about-copy reveal reveal-right">
            <p class="section-label">About me</p>
            <h2>Analytics with business context.</h2>

            <p class="lead">
              I build business-facing analytics that turn operational, commercial, and financial data
              into clearer decisions, structured visibility, and more useful reporting.
            </p>

            <p>
              My background combines recent training in Data Science and Business Analytics with a
              strong interest in solving real business problems through structured analytical work.
            </p>

            <p>
              I am especially interested in projects where data is not only explored, but translated
              into tools, decision-support systems, and outputs that companies can actually use.
            </p>

            <div class="about-actions">
              <div class="resume-dropdown">
                <button
                  class="button button-primary resume-dropdown-button"
                  type="button"
                  aria-expanded="false"
                  aria-haspopup="true"
                >
                  Download resume
                  <span class="resume-dropdown-chevron" aria-hidden="true">▾</span>
                </button>

                <div class="resume-dropdown-menu" aria-label="Resume versions">
                  <a href="/cv/ANTONIO%20Data%20AnalystCV.pdf" download>
                    <strong>Data Analyst / BI</strong>
                    <span>Reporting, dashboards, SQL, Power BI</span>
                  </a>

                  <a href="/cv/ANTONIO_Business%20Analyst.%20CV.pdf" download>
                    <strong>Business Analyst</strong>
                    <span>Processes, requirements, stakeholders</span>
                  </a>

                  <a href="/cv/ANTONIO_Data%20Scientist.%20CV.pdf" download>
                    <strong>Data Science / AI</strong>
                    <span>Python, ML, modelling, applied AI</span>
                  </a>

                  <a href="/cv/ANTONIO_FP%26A%20%20Controlling.%20CV.pdf" download>
                    <strong>FP&A / Controlling</strong>
                    <span>Planning, forecasting, finance analytics</span>
                  </a>
                </div>
              </div>

              <a
                class="button button-secondary reveal reveal-up"
                style="--reveal-delay: 140ms;"
                href="https://www.linkedin.com/in/antonio-gonzalez-189963224"
                target="_blank"
                rel="noopener noreferrer"
              >
                LinkedIn
              </a>
              <a
                class="button button-secondary reveal reveal-up"
                style="--reveal-delay: 200ms;"
                href="mailto:antonio.business444@gmail.com"
              >
                Email
              </a>
            </div>
          </div>
        </div>
      </section>

      <section id="projects" class="section projects-section">
        <div class="container">
          <div class="projects-header reveal reveal-up">
            <p class="section-label">Selected work</p>
            <h2>Applied analytics projects built around real business decisions.</h2>
            <p class="projects-intro">
              Explore the portfolio by role positioning. Each case is designed to show how I use
              data to clarify problems, diagnose drivers, and support management action.
            </p>

            <div class="project-filter-row" aria-label="Project track filters">
              {filterOptions.map((filter) => (
                <button
                  type="button"
                  class="project-filter-button"
                  data-project-filter={filter.key}
                  aria-pressed={filter.key === "all" ? "true" : "false"}
                >
                  <span>{filter.label}</span>
                  {filter.key !== "all" && (
  <span class="project-filter-count">{filter.count}</span>
)}
                </button>
              ))}
            </div>
          </div>

          <div class="projects-carousel-shell reveal reveal-up" style="--reveal-delay: 90ms;">
            <button
              type="button"
              class="projects-carousel-arrow projects-carousel-arrow-left"
              id="projects-carousel-prev"
              aria-label="Previous projects"
            >
              ←
            </button>

            <div class="projects-carousel-viewport">
              <div class="projects-carousel-track" id="projects-carousel-track">
                {featuredProjects.map((project, index) => (
                 <a
  href={project.href}
  class="project-carousel-card-link"
  data-project-tracks={project.tracks.join(" ")}
  data-original-index={index}
  data-priority-data-analyst-bi={project.priorityByTrack?.["data-analyst-bi"] ?? 999}
  data-priority-business-analyst={project.priorityByTrack?.["business-analyst"] ?? 999}
  data-priority-fpa-controlling={project.priorityByTrack?.["fpa-controlling"] ?? 999}
  data-priority-data-science-ai={project.priorityByTrack?.["data-science-ai"] ?? 999}
  aria-label={`Open ${project.title}`}
>
                    <article class={`project-carousel-card ${index === 0 ? "project-carousel-card--featured" : ""}`}>
                      <div class="project-carousel-card-media">
                        <img src={project.image} alt={project.imageAlt} loading="lazy" />
                      </div>

                      <div class="project-carousel-card-body">
                        <div class="project-carousel-card-topline">
                          <span class="project-carousel-card-eyebrow">{project.eyebrow}</span>
                          {project.badge && (
                            <span class="project-carousel-card-badge">{project.badge}</span>
                          )}
                        </div>

                        <h3>{project.title}</h3>

                        <p class="project-carousel-card-description">{project.description}</p>

                        <div class="project-carousel-card-track-pills">
                          {project.tracks.map((track) => <span>{trackLabels[track]}</span>)}
                        </div>

                        <div class="project-carousel-card-highlights">
                          {project.highlights.map((item) => <span>{item}</span>)}
                        </div>

                        <div class="project-carousel-card-footer">
                          <span class="project-carousel-card-cta">{project.cta}</span>
                          <span class="project-carousel-card-arrow" aria-hidden="true">↗</span>
                        </div>
                      </div>
                    </article>
                  </a>
                ))}
              </div>
            </div>

            <button
              type="button"
              class="projects-carousel-arrow projects-carousel-arrow-right"
              id="projects-carousel-next"
              aria-label="Next projects"
            >
              →
            </button>
          </div>
        </div>
      </section>

      <section id="flagship" class="section case-section">
        <div class="container">
          <div class="case-top-shell reveal reveal-up">
            <div class="case-top-overlay"></div>

            <div class="case-top-inner">
              <div class="case-header">
                <p class="section-label">Flagship project</p>
                <h2>From fragmented commercial data to a usable decision-support system for SMEs.</h2>
                <p class="case-intro">
                  This master’s project was built around a real business need: turning scattered
                  commercial data into a practical system for visibility, analysis, and decision-making.
                </p>
              </div>

              <div class="case-metrics-grid">
                <article class="case-metric-card reveal reveal-up" style="--reveal-delay: 80ms;">
                  <span class="case-summary-label">Context</span>
                  <strong>Real SME use case</strong>
                  <p>Designed around an actual business problem rather than a purely academic exercise.</p>
                </article>

                <article class="case-metric-card reveal reveal-up" style="--reveal-delay: 150ms;">
                  <span class="case-summary-label">Build</span>
                  <strong>End-to-end workflow</strong>
                  <p>From raw data and validation to dashboarding, analytical outputs, and recommendations.</p>
                </article>

                <article class="case-metric-card reveal reveal-up" style="--reveal-delay: 220ms;">
                  <span class="case-summary-label">Outcome</span>
                  <strong>Business-facing decision support</strong>
                  <p>Created to improve visibility, support action, and make commercial decisions clearer.</p>
                </article>
              </div>
            </div>
          </div>

          <div class="case-lower-shell">
            <div class="case-transition reveal reveal-up" aria-hidden="true">
              <span class="case-transition-line"></span>
              <span class="case-transition-label">Project foundation</span>
              <span class="case-transition-line"></span>
            </div>

            <div class="case-problem-strip reveal reveal-up">
              <div class="case-problem-copy">
                <p class="case-kicker">The starting point</p>
                <h3>Different channels, different data, no single decision-support layer.</h3>
                <p>
                  Sales, customers, and product data were spread across multiple operational sources.
                  The challenge was not only to analyse the data, but to transform it into something
                  structured, reliable, and actually useful for business decisions.
                </p>
              </div>

              <div class="case-chip-row">
                <span class="case-chip reveal reveal-up" style="--reveal-delay: 70ms;">WinOmega ERP</span>
                <span class="case-chip reveal reveal-up" style="--reveal-delay: 120ms;">PrestaShop</span>
                <span class="case-chip reveal reveal-up" style="--reveal-delay: 170ms;">eBay</span>
                <span class="case-chip reveal reveal-up" style="--reveal-delay: 220ms;">Miravia</span>
                <span class="case-chip reveal reveal-up" style="--reveal-delay: 270ms;">Commercial Reporting</span>
              </div>
            </div>

            <div class="case-pipeline-grid">
              <div class="case-pipeline-copy reveal reveal-left">
                <p class="case-kicker">How the system works</p>
                <h3>One pipeline, one analytical layer, multiple business-facing outputs.</h3>
                <p>
                  The project combined data ingestion, cleaning, quality control, harmonisation, and
                  analytical modelling into a structured workflow capable of supporting reporting,
                  segmentation, recommendation logic, and decision-ready outputs.
                </p>

                <ul class="case-list">
                  <li>Data integration across multiple business sources</li>
                  <li>Validation and quality-control checks</li>
                  <li>Standardised analytical dataset creation</li>
                  <li>Customer and commercial analysis</li>
                  <li>Dashboard-ready and recommendation-ready outputs</li>
                </ul>
              </div>

              <figure class="case-pipeline-image-card reveal reveal-right">
                <button type="button" class="media-open-btn" id="open-pipeline-modal">
                  Open schema
                </button>

                <div class="case-pipeline-preview">
                  <img
                    src="/pipeline-schema.png"
                    alt="Pipeline schema of the analytical workflow"
                    loading="lazy"
                  />
                </div>
              </figure>
            </div>

            <div class="case-visuals">
              <div class="case-visuals-heading reveal reveal-up">
                <p class="case-kicker">Visual proof</p>
                <h3>What the system actually produces</h3>
                <p>
                  Each dashboard view supports a different layer of decision-making: overview, diagnosis,
                  customer understanding, and next-best commercial action.
                </p>
              </div>

              <div class="case-gallery-shell reveal reveal-scale">
                <div class="case-gallery">
                  <div class="gallery-stage-wrap">
                    <button type="button" class="gallery-arrow" id="gallery-prev" aria-label="Previous image">
                      ←
                    </button>

                    <div class="gallery-stage">
                      <img
                        id="dashboard-gallery-image"
                        src="/dashboard-overview.png"
                        alt="General business overview dashboard"
                      />
                    </div>

                    <button type="button" class="gallery-arrow" id="gallery-next" aria-label="Next image">
                      →
                    </button>
                  </div>

                  <div class="gallery-thumbs">
                    <button
                      type="button"
                      class="gallery-thumb is-active reveal reveal-up"
                      style="--reveal-delay: 70ms;"
                      data-gallery-index="0"
                      aria-pressed="true"
                    >
                      Overview
                    </button>
                    <button
                      type="button"
                      class="gallery-thumb reveal reveal-up"
                      style="--reveal-delay: 120ms;"
                      data-gallery-index="1"
                      aria-pressed="false"
                    >
                      Segmentation
                    </button>
                    <button
                      type="button"
                      class="gallery-thumb reveal reveal-up"
                      style="--reveal-delay: 170ms;"
                      data-gallery-index="2"
                      aria-pressed="false"
                    >
                      Trends
                    </button>
                    <button
                      type="button"
                      class="gallery-thumb reveal reveal-up"
                      style="--reveal-delay: 220ms;"
